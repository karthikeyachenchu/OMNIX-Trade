# ── Fyers API credentials (get from https://myapi.fyers.in) ──────────────
# Paste these tomorrow, then run:  python main.py --login
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# ── Safety interlock ──────────────────────────────────────────────────────
# Live order placement stays DISABLED unless this is exactly YES
# (and mode: live in config.yaml). Paper trading never needs it.
LIVE_TRADING_CONFIRMED=NO

# Phone push alerts (ntfy.sh). Pick something unguessable — it is a
# shared secret, not a username.
NTFY_TOPIC=
